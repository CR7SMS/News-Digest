# Copy this file to .env and fill in real values. Never commit .env.
# In GitHub Actions, set these as repository secrets instead.

# LLM judges
GOOGLE_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
# Only needed for the evaluation scripts (Claude comparison), not the daily digest
ANTHROPIC_API_KEY=your-anthropic-api-key

# Email delivery (Gmail SMTP). Leave blank to skip sending and just save output/digest_YYYY-MM-DD.html
DIGEST_EMAIL_FROM=sender@example.com
# One address, or several separated by commas
DIGEST_EMAIL_TO=recipient@example.com
# 16-character Gmail app password for DIGEST_EMAIL_FROM (not your normal password)
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
